# Mailora ML Email Classifier Environment Variables

# Service Port and Host
HOST=0.0.0.0
PORT=8000

# Model Configuration
# MODEL_TYPE options: "baseline" (TF-IDF + Logistic Regression) or "transformer" (DistilBERT)
MODEL_TYPE=baseline
MODEL_VERSION=1.0.0

# Threshold Calibration
# Emails with career probability >= CAREER_THRESHOLD are classified as CAREER_RELATED (1).
# Calibrated on validation set to optimize recall without compromising precision.
CAREER_THRESHOLD=0.50

# Path Configuration
ARTIFACTS_DIR=artifacts
DATASET_PATH=dataset/emails.csv

# Security & Data Privacy
# Set to true to allow feedback storage (anonymized hash of subject + clean label)
ENABLE_FEEDBACK_STORAGE=true
FEEDBACK_STORE_PATH=artifacts/user_feedback.jsonl

# Maximum text length limits (in characters) to protect against DoS
MAX_SUBJECT_LENGTH=500
MAX_BODY_LENGTH=50000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000
